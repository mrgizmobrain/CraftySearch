{
  "schemaVersion": 1,
  "id": "craftysearch",
  "version": "${version}",
  "name": "Crafty Search",
  "description": "Search, count and craft from the items in your nearby storage, straight from the inventory and crafting table.",
  "authors": [
    "mrgizmobrain"
  ],
  "contact": {
    "homepage": "https://github.com/mrgizmobrain/CraftySearch",
    "sources": "https://github.com/mrgizmobrain/CraftySearch",
    "issues": "https://github.com/mrgizmobrain/CraftySearch/issues"
  },
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.craftysearch.CraftySearch"
    ],
    "client": [
      "com.craftysearch.client.CraftySearchClient"
    ],
    "modmenu": [
      "com.craftysearch.client.compat.ModMenuIntegration"
    ],
    "jei_mod_plugin": [
      "com.craftysearch.client.compat.JeiIntegration"
    ],
    "rei_client": [
      "com.craftysearch.client.compat.ReiIntegration"
    ]
  },
  "mixins": [
    {
      "config": "craftysearch.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
